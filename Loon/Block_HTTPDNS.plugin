#!name=HTTPDNS拦截器
#!desc=此插件是所有去广告插件的依赖，拦截常见的HTTPDNS服务，以确保这些请求都能够在Loon的DNS框架下工作。
#!openUrl=
#!author=jqyisbest[https://github.com/jqyisbest],可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], VirgilClyne[https://github.com/VirgilClyne]
#!tag=去广告, 依赖
#!system=
#!system_version=
#!loon_version=3.4.0(962)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/HTTPDNS.png
#!date=2026-07-04 20:05:14

[Rule]
DOMAIN,dns.wechat.com,REJECT-NO-DROP
DOMAIN,paydns.wechatpay.cn,REJECT-NO-DROP
IP-CIDR, 101.226.211.106/32, REJECT-DROP-NO-DROP, no-resolve
DOMAIN-KEYWORD, httpdns, REJECT-DROP
DOMAIN-KEYWORD, httpsdns, REJECT-DROP

USER-AGENT, "httpdns*", REJECT-DROP
USER-AGENT, "httpsdns*", REJECT-DROP
USER-AGENT, "Httpdns*", REJECT-DROP
USER-AGENT, "Httpsdns*", REJECT-DROP

AND, ((URL-REGEX, ^http:\/\/119\.29\.29\.90\/d\?), (USER-AGENT, %E5%98%80%E5%97%92%E5%87%BA%E8%A1%8C*)), DIRECT
AND, ((URL-REGEX, ^http:\/\/119\.28\.28\.90\/d\?), (USER-AGENT, %E5%98%80%E5%97%92%E5%87%BA%E8%A1%8C*)), DIRECT


URL-REGEX, "^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\?", REJECT-DROP


URL-REGEX, "^http:\/\/\[[0-9a-fA-F:]+\](?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\?", REJECT-DROP

