#!name=Script-Hub
#!desc=将其他工具的Rewrite、Rule和JavaScript资源转换为Loon能识别的格式，使用前请在本插件的详情页面为[PROXY]项分配代理策略。在插件列表中点击此插件上的链接查看使用方法。
#!openUrl=https://script.hub/
#!author=xream[https://github.com/xream], Keywos[https://github.com/Keywos], CKYB[https://github.com/CKYB], 小白脸
#!tag=资源转换
#!system=
#!system_version=
#!loon_version=3.2.1(749)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/Script-Hub.png
#!date=2026-04-30 16:28:27
#!select=ScriptHub通知,开启通知,关闭通知,跟随链接
#!input=Parser_body_max
#!input=Parser_http_timeout

[Rule]
DOMAIN, scripthub.vercel.app, PROXY

[Script]
http-request ^https?:\/\/script\.hub\/($|edit\/|reload) script-path = https://raw.githubusercontent.com/jqyisbest/CustomNetworkControls/refs/heads/main/Scripts/71d45f38fd72e70b8702875677ca5a6379955faf60d51240edf3458bb678c900.js, timeout=300, , timeout=300, tag=前端界面

http-request ^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module) script-path = https://raw.githubusercontent.com/jqyisbest/CustomNetworkControls/refs/heads/main/Scripts/d1171e6520deae643c0a9b8630e0d8925dbf3f6f5ac6bd1cfc83145228377e7e.js, timeout=300, tag=Rewrite转换

http-request ^https?:\/\/script\.hub\/file\/_start_\/.+type=rule-set script-path = https://raw.githubusercontent.com/jqyisbest/CustomNetworkControls/refs/heads/main/Scripts/5f575b117bdf0130a0f6b633fdd0c681c279394e7e1ca73fc6b965244d1138c2.js, timeout=300, tag=Rule转换

http-request ^https?:\/\/script\.hub\/convert\/ script-path = https://raw.githubusercontent.com/jqyisbest/CustomNetworkControls/refs/heads/main/Scripts/884e36ed7bfefa03618447c6f3cdaf8c3ae20097e6b1d5cd2f7ccef24824b13e.js, timeout=300, tag=JavaScript转换

[MitM]
hostname=script.hub, *.script.hub