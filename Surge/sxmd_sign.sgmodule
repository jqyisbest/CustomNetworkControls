[Script]
# 定时签到
书香门第每日签到 = type=cron, cronexp="{{{CRONEXP}}}", script-path=https://raw.githubusercontent.com/jqyisbest/CustomNetworkControls/refs/heads/main/Scripts/61a065cded101c84c16e039b2c0401fb2710fac2127f7e12e7f2276c1a8cc49a.js, timeout=120, argument=account="{{{account}}}"&password="{{{password}}}"

